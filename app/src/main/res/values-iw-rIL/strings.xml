    <string name="auto_update_bloat_list_description">משיכה אוטומטית של הגרסה החדשה של המידע על היישומים המיותרים. פעולה זו מבטיחה תגיות ותיאורי יישומים עדכניים.</string>
    <string name="settings">הגדרות</string>
    <string name="app_version">גרסת היישום: %s</string>
    <string name="no_warranty_content">יישום זה מספק המלצות להסרת יישומים על סמך מידע של צד שלישי. המלצות אלו הן אינפורמטיביות במהותן ואינן מבטיחות בטיחות או תאימות למכשיר הספציפי שלך. הסרת ההתקנה של אפליקציות מערכת עלולה לגרום לבעיות בלתי צפויות, לרבות, בין היתר,: אובדן פונקציונליות, חוסר יציבות של המערכת, לולאות אתחול המכשיר, אובדן נתונים וכו\'. מפתח האפליקציה אינו אחראי לכל נזק שייגרם למכשיר שלך כתוצאה מביצוע ההמלצות שסופקו.</string>
